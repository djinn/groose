# Groose Configuration
# Copy to /etc/groose/env and fill in secrets

# Server
GROOSE_BIND=0.0.0.0:8080

# Allowed repositories (comma-separated, e.g. "org/repo1,org/repo2")
# Empty = all repos allowed if user is authorized
GROOSE_ALLOWED_REPOS=

# Allowed GitHub users (comma-separated)
GROOSE_ALLOWED_GITHUB_USERS=

# Allowed Slack users (comma-separated, Slack user IDs)
GROOSE_ALLOWED_SLACK_USERS=

# Allowed Slack teams (comma-separated, Slack workspace IDs)
GROOSE_ALLOWED_SLACK_TEAMS=

# Slack App (optional — remove if not using Slack)
SLACK_SIGNING_SECRET=
SLACK_BOT_TOKEN=
SLACK_APP_ID=
SLACK_BOT_USER_ID=

# GitHub App (optional — remove if not using GitHub)
GITHUB_WEBHOOK_SECRET=
GITHUB_APP_ID=
GITHUB_PRIVATE_KEY_PATH=/opt/groose/secrets/github-private-key.pem

# Logging
RUST_LOG=info